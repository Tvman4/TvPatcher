<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TvPatcher"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PATCH ACCESS"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/grantPatchAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRANT PATCH ACCESS"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PATCH TOOLS"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/copyObb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COPY OBB"/>

        <Button
            android:id="@+id/restoreCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESTORE CACHE"
            android:layout_marginTop="10dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEEDS AUTH"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GO INTO GTAG AND STAY IN A LOBBY FOR 15–30 SECONDS FOR AUTH"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for patch access..."
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

</ScrollView>
