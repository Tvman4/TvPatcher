<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TvPatcher" android:textSize="30sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Purchase verification + ADB patching" android:gravity="center" android:layout_marginBottom="12dp" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content" app:tabGravity="fill" app:tabMode="fixed" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="18dp">
            <TextView android:id="@+id/patchLocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔒 Patching is locked. Complete OTP verification first." android:textSize="16sp" android:gravity="center" android:padding="16dp" />
            <TextView android:id="@+id/otpChallenge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Challenge: —" android:textSize="15sp" android:paddingTop="8dp" />
            <TextView android:id="@+id/otpCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OTP: —" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:padding="18dp" />
            <Button android:id="@+id/requestOtp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Request OTP" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="After requesting, use the companion Discord bot's /verify command with the challenge and your headset details. The bot returns an OTP to this screen." android:textSize="14sp" android:padding="10dp" />
            <Button android:id="@+id/metaLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Official Meta Login" />
            <Button android:id="@+id/metaDone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I've Finished Meta Login" />
            <Button android:id="@+id/grantPatchAccess" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grant Patch Access" />
            <Button android:id="@+id/copyObb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copy OBB (ADB)" />
            <Button android:id="@+id/restoreCache" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore Cache (ADB)" />
            <EditText android:id="@+id/redeemText" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Exact text entered in the real GTAG redeem field" android:inputType="text" />
            <Button android:id="@+id/checkAuth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check Auth (ADB)" />
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Request OTP to begin." android:textSize="15sp" android:gravity="center" android:padding="12dp" />
</LinearLayout>
